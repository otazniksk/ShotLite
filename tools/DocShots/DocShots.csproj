<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Renders the wiki images (screenshots and GIFs) from ShotLite's real UI over fictional HTML scenes.
    A developer tool only: not part of the app, the installer or the release build. Usage: see Program.cs.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 100 % scaling, so the images look the same on every PC. -->
    <ApplicationHighDpiMode>DpiUnaware</ApplicationHighDpiMode>
    <RootNamespace>DocShots</RootNamespace>
    <AssemblyName>DocShots</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ShotLite\ShotLite.csproj" />
    <None Include="scenes\*.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
